SERVICE_API_KEY=your_internal_service_api_key_here
# Qdrant Vector Store Configuration
# Remote URL (e.g. http://localhost:6333 or cloud https://...) or ':memory:' for in-memory local testing
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Optional local filesystem directory for embedded file-backed storage (leave unset for URL mode)
QDRANT_LOCAL_PATH=
QDRANT_COLLECTION_NAME=knowledge_chunks
QDRANT_DISTANCE=Cosine
QDRANT_TIMEOUT=20.0
QDRANT_PREFER_GRPC=false
MONGODB_URI=mongodb://localhost:27017/enterprise_knowledge

# Embedding Configuration
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768
EMBEDDING_TASK_TYPE=RETRIEVAL_DOCUMENT
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT=30.0
EMBEDDING_MAX_RETRIES=4
EMBEDDING_BACKOFF_FACTOR=1.5
EMBEDDING_MIN_BACKOFF=0.5
EMBEDDING_MAX_BACKOFF=10.0

# Gemini Generation & RAG Configuration
GEMINI_GENERATION_MODEL=gemini-2.5-flash
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.65
RAG_TEMPERATURE=0.0
RAG_MAX_OUTPUT_TOKENS=2048
RAG_GENERATION_TIMEOUT=30.0

# Optional Legacy / OpenAI Configuration
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here

# Text Chunking Configuration
CHUNK_SIZE=800
CHUNK_OVERLAP=120
CHUNK_MIN_SIZE=20
CHUNK_ID_PREFIX=chunk
TOKENIZER_STRATEGY=tiktoken
TIKTOKEN_ENCODING=cl100k_base
